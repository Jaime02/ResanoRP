{
  "tabWidth": 2,
  "singleQuote": false,
  "printWidth": 120,
  "semi": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/vite.config.*.timestamp-*.*",
    "dist/**",
    "build/**",
    "node_modules/**",
    "coverage/**",
    "pdf.worker.min.mjs",
    "src/lib/powersync-lite/**"
  ],
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./src/routes/styles.css",
    "functions": ["clsx", "cn", "cva"],
    "preserveWhitespace": true
  }
}
